# ---- OpenAI（留空則使用離線規則式備援）----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- AWS Transcribe / Polly ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
# Transcribe 批次轉錄需要先把音檔上傳到 S3
AWS_S3_BUCKET=
# 選填：AWS Transcribe 自訂詞彙表名稱
AWS_TRANSCRIBE_VOCABULARY=
POLLY_VOICE_ID=Zhiyu

# ---- Firebase（留空則使用本機 JSON 檔儲存）----
FIREBASE_CREDENTIALS=

# ---- Search agent（Google Programmable Search，留空則停用）----
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

CORS_ORIGINS=http://localhost:3000
